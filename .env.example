# Local development settings. Copy to .env and export before running the API.
HTTP_ADDR=127.0.0.1:8080
WORKER_HEALTH_ADDR=127.0.0.1:8081
# Optional split Compose diagnostics overrides.
# API_OBSERVABILITY_ADDR=127.0.0.1:9091
# WORKER_OBSERVABILITY_ADDR=127.0.0.1:9092
# Enable a separate local diagnostics listener if needed.
# OBSERVABILITY_ADDR=127.0.0.1:9091
PPROF_ENABLED=false
SECKILL_AUDIT_INTERVAL=1m
# Queue limits apply per shard, including the legacy queue. Zero disables a limit.
SECKILL_OUTBOX_LIMIT=0
# Limit reservations awaiting confirmation or cancellation across Redis and Kafka.
SECKILL_PENDING_LIMIT=0
# Creation defaults for new activities. Every API and Worker uses the same cluster addresses.
SECKILL_REDIS_SHARDED=false
# SECKILL_REDIS_CLUSTER_ADDRS=127.0.0.1:7000,127.0.0.1:7001,127.0.0.1:7002
SECKILL_STOCK_BUCKETS=1
# Enable only for local login tests. One-time codes are printed to API logs.
AUTH_DEV_LOG_CODES=false
# User ID authorized to create and edit shops. Zero disables maintenance.
SHOP_ADMIN_USER_ID=0
# User ID authorized to create vouchers and seckill activities.
VOUCHER_ADMIN_USER_ID=0
MYSQL_PORT=23306
# Maximum MySQL connections per Go process.
MYSQL_MAX_OPEN_CONNS=20
MYSQL_DATABASE=hmdp
MYSQL_USER=hmdp
MYSQL_PASSWORD=hmdp_dev_mysql
REDIS_PORT=26379
REDIS_PASSWORD=hmdp_dev_redis
REDIS_MASTER_NAME=hmdp-master
REDIS_SENTINEL_ADDRS=127.0.0.1:26380,127.0.0.1:26381,127.0.0.1:26382
# Client password for external Sentinels with authentication enabled.
# REDIS_SENTINEL_PASSWORD=
KAFKA_PORT=29092
KAFKA_RELAY_WORKERS=4
KAFKA_CONSUMER_WORKERS=3
# Redis reservations older than this are cancelled by the background worker.
SECKILL_PENDING_TIMEOUT=15m

# Set these only to connect to services at other addresses.
# MYSQL_ADDR=127.0.0.1:23306
# For standalone Redis, leave REDIS_SENTINEL_ADDRS empty and set REDIS_ADDR.
# REDIS_SENTINEL_ADDRS=
# REDIS_ADDR=127.0.0.1:26379
# KAFKA_BROKERS=127.0.0.1:29092

# Optional S3-compatible image storage. Create the bucket before use.
# MEDIA_S3_ENDPOINT=http://127.0.0.1:29000
# MEDIA_S3_ACCESS_KEY=
# MEDIA_S3_SECRET_KEY=
# MEDIA_S3_BUCKET=hmdp-images
# MEDIA_PUBLIC_URL=http://127.0.0.1:29000/hmdp-images

# Optional list of authors whose new blog notifications use read-time fanout.
# SOCIAL_PULL_AUTHOR_IDS=2,7
